# GitHub OAuth App (https://github.com/settings/developers)
# Callback URL: https://YOURDOMAIN/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Long random string: openssl rand -hex 32
SESSION_SECRET=
# OpenRouter key (free account, no card): https://openrouter.ai/keys
OPENROUTER_KEY=
# Your deployed origin, e.g. https://os.orangopus.org (used for OAuth redirect)
APP_ORIGIN=http://localhost:3000
